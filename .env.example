# Database
# Railway: auto-populated when you add a PostgreSQL plugin — copy the value shown
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tech_ziwei
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tech_ziwei_test

# Auth
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-character-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Redis
# Railway: auto-populated when you add a Redis plugin — copy the value shown
REDIS_URL=redis://localhost:6379/0

# Stripe
# Use sk_live_... in production; get webhook secret from Stripe Dashboard → Webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App
# Set to "production" on Railway to enable strict CORS, HSTS, and hide /docs
ENVIRONMENT=development
# Set to your Railway frontend service URL in production
FRONTEND_URL=http://localhost:3000
